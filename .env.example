# ==============================================================================
# PROXVEL App - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Copia este archivo como `.env` y define la URL de tu backend desplegado.
#
# Uso con Flutter (nativo en Flutter 3.7+):
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# En VS Code (.vscode/launch.json):
#   "args": ["--dart-define-from-file=.env"]
# ==============================================================================

# URL base del backend desplegado (ej. Railway, Render, VPS o dominio propio).
# IMPORTANTE: Debe incluir el protocolo (https://) y el sufijo /api/v1 sin barra final.
API_BASE_URL=https://proxback-production.up.railway.app/api/v1

# Si deseas forzar mocks locales cuando no hay internet o falla la red (true/false)
USE_MOCK_FALLBACK=false
